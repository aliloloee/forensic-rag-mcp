# Copy to .env and fill in.

# LLM: Claude through OpenRouter (any OpenRouter model id works, e.g. google/gemma-4-31b-it)
OPENROUTER_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-5.5
# cheaper alternative for the many per-email inference calls:
# LLM_MODEL=anthropic/claude-haiku-4.5
LLM_TEMPERATURE=0.3

# Embeddings: Voyage AI (free key at https://www.voyageai.com)
VOYAGE_API_KEY=
EMBED_MODEL=voyage-3.5

# Weaviate: local Docker (docker compose up -d) ...
WEAVIATE_HOST=localhost
WEAVIATE_PORT=8080
WEAVIATE_GRPC_PORT=50051
# ... or Weaviate Cloud (takes precedence when set)
WEAVIATE_URL=
WEAVIATE_API_KEY=

# ---- Hosted mode only (python -m forensic_rag.mcp_server --http) ----
# Public base URL of the server; the MCP endpoint is PUBLIC_URL/mcp
PUBLIC_URL=http://localhost:8000
# WorkOS AuthKit domain; leave empty for an open dev server without login
AUTHKIT_DOMAIN=
# Random string that signs upload/report links, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
MAX_UPLOAD_EMAILS=500
MAX_UPLOAD_MB=20
MAX_DATASETS_PER_USER=5
